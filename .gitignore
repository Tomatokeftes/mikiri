# Footage and generated media stay out of the repository
*.egg-info/
*.pyc
*.tmp
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
build/
demo/*.MOV
demo/*.MP4
demo/*.mov
demo/*.mp4
demo/demo.tmp.mp4
demo/demo_truth.json
dist/
exports/
tests/_out/
# Benchmark footage: the clips and anything rendered from them. The manifest
# and the README that describe them are tracked, which is the point of the
# folder, so the ignore is a blanket with those carved back out -- and the
# negations come after the blanket, because git takes the last match.
benchmarks/**
!benchmarks/README.md
!benchmarks/clips.json
# Saved projects. The negation is last so it actually wins: a saved project
# next to the demo clip is worth keeping, and the negation used to sit above
# the rule it negated, where git's last-match-wins left it doing nothing.
*.mikiri.json
*.jumplab.json
!demo/*.mikiri.json
# The desktop app's worktrees and per-user settings live under .claude; only
# the preview launch config is the repository's business, so it is carved
# back out of the blanket, negation last as above.
.claude/*
!.claude/launch.json
